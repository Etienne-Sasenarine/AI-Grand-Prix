# Consolidated .gitignore for the AI Grand Prix repo.
# One file at the root; per-subsystem .gitignores were merged in here.
#
# Policy: model weights are kept IN git on purpose (they are 6-13 MB each and
# a checkpoint is only meaningful next to the code that produced it). We ignore
# the large *regenerable output directories* instead of blanket-ignoring *.pt.
# Kept deliberately: training/checkpoints/, perception/models/, deploy/runtime/models/.

# ============================== Python ==============================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ============================ Virtualenvs ===========================
venv/
.venv/
.venv_mac/
winvenv/
env/

# =========================== OS / editor ============================
.DS_Store
# Windows reserved device name: accidental `> nul` redirects create this file
# and `git add` then fails with "unable to index file 'nul'".
nul
NUL

# =============== Training (Isaac Lab) — large, regenerable ==========
# A single PPO run writes gigabytes of TensorBoard events and checkpoints.
training/logs/
training/runs/
training/outputs/
training/models/
training/eval/
wandb/
*.tfevents.*
*.jsonl.gz
# Isaac Sim / Omniverse scratch
.nvidia-omniverse/
kit/
*.log

# ================= Perception (YOLO) — datasets & runs ==============
# The Roboflow dataset the notebook trained on (~75 MB of JPGs + COCO json).
perception/frames/
**/frames/
datasets/
runs/                      # ultralytics training output
_vision_debug/

# ==================== Deploy / bench output =========================
hover_logs/
deploy/**/hover_logs/
bench_*.json
bench_*_report.md
logs/*.csv
logs/*.txt

# ================= Large binaries never for git =====================
*.zip                      # dataset exports (Roboflow, etc.)
*.bag                      # ROS bags
*.mcap                     # MCAP recordings
AIGP_3385/                 # Isaac Sim install

# ================= LaTeX build products (docs/paper) ================
docs/paper/neurips/*.aux
docs/paper/neurips/*.log
docs/paper/neurips/*.out
docs/paper/neurips/*.toc
docs/paper/neurips/paper.pdf
